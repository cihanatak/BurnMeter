{
  "_about": [
    "Cases for firestore.rules. `python scripts/pro_admin.py rules-test` runs them on Google's",
    "rules engine (Rules API projects:test, deploys nothing); tests/test_firestore_rules.py checks",
    "their shape offline. Paths are under /databases/(default)/documents/. {\"$t\": s} is a time",
    "s seconds from \"now\" (every request happens at \"now\"); {\"$chars\": n} is a string of n",
    "characters. \"stored\" is the document as it is before the request. Every case sees all",
    "accounts' users/{uid} documents; null means the document does not exist."
  ],
  "now": "2026-10-29T12:00:00Z",
  "accounts": {
    "alice": {"verified": true, "users_doc": {"plan": "pro", "status": "active"}},
    "hank": {"verified": true, "users_doc": {"plan": "pro"}},
    "bob": {"verified": true, "users_doc": {"plan": "free"}},
    "carol": {"verified": false, "users_doc": {"plan": "pro", "status": "active"}},
    "dave": {"verified": true, "users_doc": {"plan": "pro", "status": "suspended"}},
    "erin": {"verified": true, "users_doc": null},
    "frank": {"verified": true, "users_doc": {}}
  },
  "cases": [
    {"name": "a 0.3.6 client creates its device doc", "expect": "ALLOW",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "a Pro doc without a status field counts as active", "expect": "ALLOW",
     "as": "hank", "op": "create", "path": "users/hank/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "a 0.3.6 client updates after 5 minutes", "expect": "ALLOW",
     "as": "alice", "op": "update", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -301}},
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "a second write within 5 minutes is refused", "expect": "DENY",
     "as": "alice", "op": "update", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -299}},
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "exactly 5 minutes is still too soon", "expect": "DENY",
     "as": "alice", "op": "update", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -300}},
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "a 0.3.5 client with its own clock and a plaintext label still syncs", "expect": "ALLOW",
     "as": "alice", "op": "update", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "label": "Studio PC", "updated_at": {"$t": -600}},
     "data": {"blob": "Z0FBQUFBQm4", "label": "Studio PC", "updated_at": {"$t": -30}}},
    {"name": "a 0.3.5 client whose clock is 3 minutes behind is refused", "expect": "DENY",
     "as": "alice", "op": "update", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -900}},
     "data": {"blob": "Z0FBQUFBQm4", "label": "Studio PC", "updated_at": {"$t": -180}}},
    {"name": "a 0.3.5 client whose clock is 3 minutes ahead is refused", "expect": "DENY",
     "as": "alice", "op": "update", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -900}},
     "data": {"blob": "Z0FBQUFBQm4", "label": "Studio PC", "updated_at": {"$t": 180}}},
    {"name": "a doc written before updated_at existed can be overwritten", "expect": "ALLOW",
     "as": "alice", "op": "update", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk"},
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "updated_at must be a timestamp", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": 1761739200}},
    {"name": "a doc without updated_at is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4"}},
    {"name": "a doc without a blob is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"updated_at": {"$t": 0}}},
    {"name": "extra fields are refused, so a client cannot smuggle a plan in", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}, "plan": "pro"}},
    {"name": "an empty blob is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "", "updated_at": {"$t": 0}}},
    {"name": "a blob that is not a string is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": 42, "updated_at": {"$t": 0}}},
    {"name": "a 256 KiB blob is accepted", "expect": "ALLOW",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": {"$chars": 262144}, "updated_at": {"$t": 0}}},
    {"name": "a blob over 256 KiB is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": {"$chars": 262145}, "updated_at": {"$t": 0}}},
    {"name": "a label over 200 characters is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "label": {"$chars": 201}, "updated_at": {"$t": 0}}},
    {"name": "a label that is not a string is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "label": 7, "updated_at": {"$t": 0}}},
    {"name": "device ids are lowercase hex: uppercase is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/0123456789AB",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "device ids are 12 characters: a short one is refused", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/devices/dev1",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},

    {"name": "a free account cannot sync", "expect": "DENY",
     "as": "bob", "op": "create", "path": "users/bob/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "an account without a users doc cannot sync", "expect": "DENY",
     "as": "erin", "op": "create", "path": "users/erin/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "a users doc without a plan field is free", "expect": "DENY",
     "as": "frank", "op": "create", "path": "users/frank/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "a Pro account cannot sync before its email is verified", "expect": "DENY",
     "as": "carol", "op": "create", "path": "users/carol/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "a suspended Pro account cannot sync", "expect": "DENY",
     "as": "dave", "op": "update", "path": "users/dave/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -600}},
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "a signed-out request cannot write", "expect": "DENY",
     "as": null, "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},
    {"name": "nobody writes into another account's devices", "expect": "DENY",
     "as": "hank", "op": "create", "path": "users/alice/devices/0123456789ab",
     "data": {"blob": "Z0FBQUFBQm4", "updated_at": {"$t": 0}}},

    {"name": "a Pro owner reads a device doc", "expect": "ALLOW",
     "as": "alice", "op": "get", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -60}}},
    {"name": "a Pro owner lists its devices", "expect": "ALLOW",
     "as": "alice", "op": "list", "path": "users/alice/devices/0123456789ab"},
    {"name": "a free account cannot read its old device docs", "expect": "DENY",
     "as": "bob", "op": "get", "path": "users/bob/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -60}}},
    {"name": "a free account cannot list devices", "expect": "DENY",
     "as": "bob", "op": "list", "path": "users/bob/devices/0123456789ab"},
    {"name": "an unverified account cannot list devices", "expect": "DENY",
     "as": "carol", "op": "list", "path": "users/carol/devices/0123456789ab"},
    {"name": "a suspended account cannot read", "expect": "DENY",
     "as": "dave", "op": "get", "path": "users/dave/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -60}}},
    {"name": "nobody reads another account's devices", "expect": "DENY",
     "as": "hank", "op": "get", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -60}}},
    {"name": "a signed-out request cannot list", "expect": "DENY",
     "as": null, "op": "list", "path": "users/alice/devices/0123456789ab"},

    {"name": "a Pro owner reads its plan", "expect": "ALLOW",
     "as": "alice", "op": "get", "path": "users/alice",
     "stored": {"plan": "pro", "status": "active"}},
    {"name": "a free account reads its plan", "expect": "ALLOW",
     "as": "bob", "op": "get", "path": "users/bob",
     "stored": {"plan": "free"}},
    {"name": "an unverified account reads its plan", "expect": "ALLOW",
     "as": "carol", "op": "get", "path": "users/carol",
     "stored": {"plan": "pro", "status": "active"}},
    {"name": "nobody reads another account's plan", "expect": "DENY",
     "as": "alice", "op": "get", "path": "users/bob",
     "stored": {"plan": "free"}},
    {"name": "nobody lists accounts", "expect": "DENY",
     "as": "alice", "op": "list", "path": "users/alice"},
    {"name": "a free account cannot grant itself Pro", "expect": "DENY",
     "as": "bob", "op": "update", "path": "users/bob",
     "stored": {"plan": "free"},
     "data": {"plan": "pro", "status": "active"}},
    {"name": "an account cannot create its own users doc", "expect": "DENY",
     "as": "erin", "op": "create", "path": "users/erin",
     "data": {"plan": "pro"}},
    {"name": "an account cannot delete its users doc", "expect": "DENY",
     "as": "dave", "op": "delete", "path": "users/dave",
     "stored": {"plan": "pro", "status": "suspended"}},

    {"name": "a free account deletes its own device doc", "expect": "ALLOW",
     "as": "bob", "op": "delete", "path": "users/bob/devices/0123456789ab",
     "stored": {"blob": "b2xk", "label": "Studio PC", "updated_at": {"$t": -60}}},
    {"name": "a Pro owner deletes a device doc right after writing it", "expect": "ALLOW",
     "as": "alice", "op": "delete", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -5}}},
    {"name": "nobody deletes another account's device doc", "expect": "DENY",
     "as": "hank", "op": "delete", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -60}}},
    {"name": "a signed-out request cannot delete", "expect": "DENY",
     "as": null, "op": "delete", "path": "users/alice/devices/0123456789ab",
     "stored": {"blob": "b2xk", "updated_at": {"$t": -60}}},

    {"name": "collections outside users/ are closed", "expect": "DENY",
     "as": "alice", "op": "create", "path": "public/notes",
     "data": {"text": "hi"}},
    {"name": "other subcollections of a users doc are closed", "expect": "DENY",
     "as": "alice", "op": "create", "path": "users/alice/settings/theme",
     "data": {"dark": true}}
  ]
}
